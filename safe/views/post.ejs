<!DOCTYPE html>
<html>
<head><title>CampusConnect (Safe) — <%= post.title %></title></head>
<body>
  <p><a href="/dashboard">Back to dashboard</a></p>
  <h1><%= post.title %></h1>
  <p>by <%= post.username %></p>
  <p><%= post.body %></p>

  <h2>Comments</h2>
  <ul>
    <% comments.forEach(function(c) { %>
      <li>
        <strong><%= c.username %>:</strong>
        <%= c.body %>
      </li>
    <% }) %>
  </ul>

  <h3>Add a comment</h3>
  <form method="POST" action="/dashboard/post/<%= post.id %>/comment">
    <textarea name="body" rows="3" cols="40"></textarea><br>
    <button type="submit">Post comment</button>
  </form>
</body>
</html>