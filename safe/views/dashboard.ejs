<!DOCTYPE html>
<html>
<head><title>CampusConnect (Safe) — Dashboard</title></head>
<body>
  <h1>Welcome, <%= user.full_name %></h1>
  <p><a href="/logout">Log out</a></p>
    <p><a href="/dashboard/check-grade">Check Grade Record</a></p>
  <p><a href="/dashboard/search">Search Posts</a></p>
    <p><a href="/dashboard/settings">Account Settings</a></p>
  <h2>Recent posts</h2>
  <ul>
    <% posts.forEach(function(p) { %>
            <li><strong><a href="/dashboard/post/<%= p.id %>"><%= p.title %></a></strong> by <%= p.username %><br><%= p.body %></li>
    <% }) %>
  </ul>
    <div id="tab-banner"></div>
  <script>
    // FIX for DOM-based XSS: textContent (not innerHTML) is used, so
    // whatever is in location.hash is always treated as plain text and
    // can never be parsed as HTML or execute as a script.
    function showTabFromHash() {
      var hash = decodeURIComponent(location.hash.substring(1));
      if (hash) {
        document.getElementById('tab-banner').textContent = 'Viewing tab: ' + hash;
      }
    }
    window.addEventListener('hashchange', showTabFromHash);
    showTabFromHash();
  </script>
</body>
</html>